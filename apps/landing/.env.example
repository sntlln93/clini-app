VITE_PANEL_URL=http://localhost:5174
# The API the contact form posts to (its only call to the API, ADR 0011).
VITE_API_URL=http://localhost:8080
# The landing's own public origin: every absolute URL it declares (canonical,
# og:url, og:image, /sitemap.xml, robots.txt's Sitemap line) comes from it, so
# without it they are left out and /sitemap.xml answers 404.
VITE_SITE_URL=http://localhost:5176
# Optional: `true`/`false` forces the error pages to show (or not) the exact
# error (#304); unset, only the dev server shows it.
# VITE_APP_DEBUG=true
