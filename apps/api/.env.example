APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

# Panel first, then the platform dashboard and the landing: the panel origin must stay first in
# FRONTEND_URL (subscription, invitation and verification links read its first entry). The
# landing is a CORS origin for its contact form only, never a stateful domain (ADR 0011).
FRONTEND_URL=http://localhost:5174,http://localhost:5175,http://localhost:5176
SANCTUM_STATEFUL_DOMAINS=localhost:5174,localhost:5175

# Platform dashboard (#232): the only origin(s) allowed to call /api/v1/admin/*
# (an empty value rejects every admin request; clinic routes reject these
# origins), and the timezone platform stats bucket days in, which must equal
# REPORTING_TIMEZONE in apps/dashboard/src/lib/format.ts (a rebuild to change).
ADMIN_ALLOWED_ORIGINS=http://localhost:5175
ADMIN_REPORTING_TIMEZONE=America/Argentina/Buenos_Aires

# The landing's contact form (#248): where each new request is mailed (empty sends
# none; they're always in the dashboard) and the days a closed request is kept
# before it's deleted (0 keeps them forever).
CONTACT_NOTIFICATION_EMAIL=
CONTACT_RETENTION_DAYS=180

# The mails' brand (#236, config/brand.php). Without BRAND_MAIL_LOGO_URL the
# logo is the PNG the panel publishes (first FRONTEND_URL entry + /brand/...).
BRAND_NAME=Clini
BRAND_MAIL_LOGO_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
# Host-exposed port for the pgsql container (not the internal DB_PORT above,
# which stays 5432 on the sail network). Same reasoning as APP_PORT above:
# avoids colliding with other, unrelated Postgres-based projects' containers
# on the same machine that also default to the standard 5432.
FORWARD_DB_PORT=55432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@clini.test"
MAIL_FROM_NAME="${BRAND_NAME}"
# Production uses MAIL_MAILER=resend with this key; leave empty in dev.
RESEND_API_KEY=

# Mercado Pago subscription billing (#28) — never commit real values.
# Sandbox: seller and buyer are both test users; the APP_USR-... Access Token
# and Public Key on the app's "Credenciales de prueba" page belong to the test
# seller and go here. See docs/architecture/subscriptions.md.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Practice (Consultorio) monthly price in whole ARS pesos: the base amount
# covers the included professionals; each active one past them adds the
# extra amount (config/plans.php).
MERCADOPAGO_PLAN_AMOUNT=
MERCADOPAGO_PLAN_CURRENCY=ARS
PLAN_PRACTICE_INCLUDED_PROFESSIONALS=5
PLAN_PRACTICE_EXTRA_PROFESSIONAL_AMOUNT=
# Percent off the monthly price when paying the whole year (#240).
PLAN_PRACTICE_ANNUAL_DISCOUNT_PERCENT=40
# Free's monthly appointment limit and the count that warns the owners by
# mail; 0 or empty means no limit (and no warning).
PLAN_FREE_MONTHLY_APPOINTMENT_LIMIT=0
PLAN_FREE_APPOINTMENT_WARNING_THRESHOLD=0
# Checkout return: the API route that redirects to the panel's /ajustes.
MERCADOPAGO_BACK_URL="${APP_URL}/api/v1/subscription/return"

# The `media` disk (uploaded files, ADR 0015). Dev points at the `s3` service
# (s3mock, any key works); production at Cloudflare R2: region `auto`,
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and an R2 API token.
AWS_ACCESS_KEY_ID=clini
AWS_SECRET_ACCESS_KEY=clini-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=clini
AWS_ENDPOINT=http://s3:9090
AWS_USE_PATH_STYLE_ENDPOINT=true

