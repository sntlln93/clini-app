APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

# Panel first, then the platform dashboard: the panel origin must stay first in
# FRONTEND_URL (subscription, invitation and verification links read its first entry).
FRONTEND_URL=http://localhost:5174,http://localhost:5175
SANCTUM_STATEFUL_DOMAINS=localhost:5174,localhost:5175

# Platform dashboard (#232): the only origin(s) allowed to call /api/v1/admin/*
# (an empty value rejects every admin request; clinic routes reject these
# origins), and the timezone platform stats bucket days in, which must equal
# REPORTING_TIMEZONE in apps/dashboard/src/lib/format.ts (a rebuild to change).
ADMIN_ALLOWED_ORIGINS=http://localhost:5175
ADMIN_REPORTING_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
# Host-exposed port for the pgsql container (not the internal DB_PORT above,
# which stays 5432 on the sail network). Same reasoning as APP_PORT above:
# avoids colliding with other, unrelated Postgres-based projects' containers
# on the same machine that also default to the standard 5432.
FORWARD_DB_PORT=55432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@clini.test"
MAIL_FROM_NAME="${APP_NAME}"
# Production uses MAIL_MAILER=resend with this key; leave empty in dev.
RESEND_API_KEY=

# Mercado Pago subscription billing (#28) — never commit real values.
# Sandbox: seller and buyer are both test users; the APP_USR-... Access Token
# and Public Key on the app's "Credenciales de prueba" page belong to the test
# seller and go here. See docs/architecture/subscriptions.md.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Monthly price in whole ARS pesos.
MERCADOPAGO_PLAN_AMOUNT=
MERCADOPAGO_PLAN_CURRENCY=ARS
# Checkout return: the API route that redirects to the panel's /ajustes.
MERCADOPAGO_BACK_URL="${APP_URL}/api/v1/subscription/return"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

