{
  "name": "clini-app",
  "private": true,
  "type": "module",
  "workspaces": ["apps/panel"],
  "scripts": {
    "test:e2e": "playwright test",
    "lint": "eslint e2e playwright.config.ts --fix",
    "lint:check": "eslint e2e playwright.config.ts --max-warnings=0",
